VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Leave blank until the Anchor program is actually deployed to devnet.
VITE_SILENT_CIRCLE_PROGRAM_ID=
# Deployment-side placeholders. Replace these after you deploy the program and computation.
ANCHOR_PROGRAM_ID=11111111111111111111111111111111
PSI_COMPUTATION_PUBKEY=11111111111111111111111111111111
ARCIUM_MXE_PUBKEY=11111111111111111111111111111111

# ---------------------------------------------------------------------------
# Arcium infrastructure accounts — populate with `arcium info --cluster devnet`
# after running: arcium register-mxe && arcium register-computation arcium_compute/
# ---------------------------------------------------------------------------
VITE_ARCIUM_PROGRAM_ID=
VITE_ARCIUM_MXE_PUBKEY=
VITE_ARCIUM_MEMPOOL_PUBKEY=
VITE_ARCIUM_EXECPOOL_PUBKEY=
VITE_ARCIUM_CLUSTER_PUBKEY=
VITE_ARCIUM_COMP_DEF_PUBKEY=
VITE_ARCIUM_FEE_POOL_PUBKEY=
VITE_ARCIUM_CLOCK_PUBKEY=
# 64-char hex of the cluster X25519 pubkey from `arcium info --cluster devnet`
# Set this to avoid an extra RPC call on every start_psi invocation.
VITE_ARCIUM_CLUSTER_X25519_PUBKEY_HEX=
